      <aliases enabled='yes' />
      <column caption='Total Revenue' datatype='real' name='[Calculation_1008860458545152]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([revenue])' />
      </column>
      <column caption='Total Unit' datatype='integer' name='[Calculation_1008860458868737]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([quantity])' />
      </column>
      <column caption='Jumlah Transaksi' datatype='integer' name='[Calculation_1008860459163650]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='COUNTD([sale_id])' />
      </column>
      <column caption='Jumlah Pelanggan' datatype='integer' name='[Calculation_1008860459245571]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='COUNTD([customer_key])' />
      </column>
      <column caption='Avg Transaction Value' datatype='real' name='[Calculation_1008860459335684]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([revenue])/COUNTD([sale_id])' />
      </column>
      <column caption='Avg Frequency' datatype='real' name='[Calculation_1008860459466757]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='COUNTD([sale_id])/COUNTD([customer_key])' />
      </column>
      <column caption='Gross Profit' datatype='real' name='[Calculation_1008860459728902]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([revenue])-SUM([quantity]*[unit_cost])' />
      </column>
      <column caption='GPM %' datatype='real' name='[Calculation_1008860459929607]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='[Calculation_1008860459728902]/SUM([revenue])' />
      </column>
      <column caption='Gross Revenue' datatype='real' name='[Calculation_1008860460036104]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([quantity]*[retail_price])' />
      </column>
      <column caption='Discount Amount' datatype='real' name='[Calculation_1008860460134409]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='[Calculation_1008860460036104]-SUM([revenue])' />
      </column>
      <column caption='Order Month' datatype='datetime' name='[Calculation_1008860460404746]' role='dimension' type='ordinal'>
        <calculation class='tableau' formula='DATETRUNC(&apos;month&apos;, [sold_at])' />
      </column>
      <column caption='Revenue MoM Growth %' datatype='real' name='[Calculation_1008860460589067]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='(SUM([revenue])-LOOKUP(SUM([revenue]), -1)) / &#13;&#10;ABS(LOOKUP(SUM([revenue]), -1))'>
          <table-calc ordering-type='Rows' />
        </calculation>
      </column>
      <column caption='Revenue Last Year' datatype='real' name='[Calculation_1008860460892172]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='LOOKUP(SUM([revenue]), -12)'>
          <table-calc ordering-type='Rows' />
        </calculation>
      </column>
      <column caption='Revenue YoY Growth %' datatype='real' name='[Calculation_1008860461260813]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='(SUM([revenue]) - LOOKUP(SUM([revenue]), -12)) /&#13;&#10; ABS(LOOKUP(SUM([revenue]), -12))'>
          <table-calc ordering-type='Rows' />
        </calculation>
      </column>
      <column caption='Is Promo' datatype='boolean' name='[Calculation_1008860461502478]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='[discount_pct]&gt;0' />
      </column>
      <column caption='% Omzet Promo' datatype='real' name='[Calculation_1008860461572111]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM(IF [discount_pct] &gt; 0 Then  [revenue] END)/SUM([revenue])' />
      </column>
      <column caption='% Transaksi Promo' datatype='real' name='[Calculation_1008860461797392]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='COUNTD(IF [discount_pct]&gt; 0 then [sale_id] END) / COUNTD([sale_id])' />
      </column>
      <column caption='Rank Subcategory in Region' datatype='integer' name='[Calculation_1008860461998097]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='RANK(SUM([revenue])) //using subcategory'>
          <table-calc ordering-type='Rows' />
        </calculation>
      </column>
      <column caption='Is Top Subcategory' datatype='boolean' name='[Calculation_1008860462186514]' role='measure' type='nominal'>
        <calculation class='tableau' formula='RANK(SUM([revenue])) = 1'>
          <table-calc ordering-type='Rows' />
        </calculation>
      </column>
      <column caption='Premium Units' datatype='integer' name='[Calculation_1008860462260243]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM(IF [subcategory] = &quot;Premium&quot; Then [quantity] END)' />
      </column>
      <column caption='Premium Revenue' datatype='real' name='[Calculation_1008860462473236]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM(IF [subcategory] = &quot;Premium&quot; Then [revenue] END)' />
      </column>
      <column caption='Region Avg ATV' datatype='real' name='[Calculation_1008860462637077]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='{ FIXED [region] : SUM([revenue]) / COUNTD([sale_id])}' />
      </column>
      <column caption='ATV vs Region' datatype='real' name='[Calculation_1008860462805014]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='[Calculation_1008860459335684] - [Calculation_1008860462637077]' />
      </column>
      <column caption='Above Region Avg' datatype='real' name='[Calculation_1008860462948375]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='[Calculation_1008860459335684] &gt; [Calculation_1008860462637077]' />
      </column>
      <column caption='Baseline Revenue' datatype='real' name='[Calculation_1008860463349786]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([revenue])' />
      </column>
      <column caption='Sim Revenue Conservative' datatype='real' name='[Calculation_1008860464799773]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='[Calculation_1008860460036104]* (1 - [Parameters].[Parameter 1008860463603740]) * (1 + [Parameters].[Parameter 1008860463603740] * 0.5)' />
      </column>
      <column caption='Sim Revenue Moderate' datatype='real' name='[Calculation_1008860465041438]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='[Calculation_1008860460036104] * (1 - [Parameters].[Parameter 1008860463603740]) * (1 + [Parameters].[Parameter 1008860463603740] * 1)' />
      </column>
      <column caption='Sim Revenue Aggressive' datatype='real' name='[Calculation_1008860465111071]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='[Calculation_1008860460036104] * (1 - [Parameters].[Parameter 1008860463603740]) * (1 + [Parameters].[Parameter 1008860463603740] * 1.5)' />
      </column>
      <column caption='Sim Units Conservative' datatype='real' name='[Calculation_1008860465176608]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([quantity])*(1+ [Parameters].[Parameter 1008860463603740] + 0.5)' />
      </column>
      <column caption='Sim Units Moderate' datatype='real' name='[Calculation_1008860465344545]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([quantity]) * (1 + [Parameters].[Parameter 1008860463603740] * 1)' />
      </column>
      <column caption='Sim units Aggressive' datatype='real' name='[Calculation_1008860465397794]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([quantity]) * (1 + [Parameters].[Parameter 1008860463603740] * 1.5)' />
      </column>
      <column caption='Impact Conservative' datatype='boolean' name='[Calculation_1008860465471523]' role='measure' type='nominal'>
        <calculation class='tableau' formula='[Calculation_1008860464799773] = [Calculation_1008860458545152]' />
      </column>
      <column caption='Impact Moderate' datatype='real' name='[Calculation_1008860465553444]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='[Calculation_1008860465041438]-[Calculation_1008860458545152]' />
      </column>
      <column caption='Impact Aggressive' datatype='real' name='[Calculation_1008860465627173]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='[Calculation_1008860465111071] - [Calculation_1008860458545152]' />
      </column>
